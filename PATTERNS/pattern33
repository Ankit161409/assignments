import java.util.Scanner;
public class pattern33 
{
	public static void main(String[] args) {
		System.out.println("enter a number");
		int x= new Scanner( System.in).nextInt();
		for(int i=1; i<=x; i++)
		{
			for(int j=x; j>=i; j--)
			{	System.out.print(j);
			}System.out.println();
		}
		
	}
}








